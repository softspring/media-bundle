{
    "name": "softspring/media-bundle",
    "description": "An media management bundle",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "doctrine/doctrine-bundle": "^2.6",
        "doctrine/migrations": "^3.2",
        "doctrine/orm": "^2.14 | ^3.0",
        "google/cloud-storage": "^1.20",
        "imagine/imagine": "^1.3",
        "softspring/crudl-controller": "^6.0@dev",
        "softspring/doctrine-paginator": "^6.0@dev",
        "softspring/doctrine-query-filters": "^6.0@dev",
        "softspring/doctrine-target-entity-resolver": "^6.0@dev",
        "softspring/events": "^6.0@dev",
        "softspring/permissions-bundle": "^6.0@dev",
        "softspring/time-ago-bundle": "^6.0@dev",
        "softspring/translatable-bundle": "^6.0@dev",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/routing": "^6.4|^7.4|^8.0",
        "symfony/security-bundle": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "symfony/twig-bundle": "^6.4|^7.4|^8.0",
        "symfony/validator": "^6.4|^7.4|^8.0",
        "twig/twig": "^2.10|^3.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "softspring/cms-bundle": "^6.0@dev"
    },
    "suggest": {
        "softspring/crudl-controller": "Required if you want to enable admin controllers",
        "google/cloud-storage": "Required to integrate media storage in GCS"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\MediaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\MediaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "composer validate --strict --no-check-lock --ansi",
            "composer install --no-scripts --ansi",
            "XDEBUG_MODE=coverage vendor/bin/phpunit",
            "vendor/bin/rector process src tests --dry-run",
            "vendor/bin/phpstan analyse src tests --level 5",
            "vendor/bin/php-cs-fixer fix --dry-run --diff",
            "vendor/bin/yaml-lint .github/ -vvv --parse-tags",
            "vendor/bin/yaml-lint config/ -vvv --parse-tags",
            "vendor/bin/yaml-lint translations/ -vvv --parse-tags"
        ],
        "fix": [
            "vendor/bin/rector process src tests",
            "vendor/bin/php-cs-fixer fix --diff"
        ]
    }
}
