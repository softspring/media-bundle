{% trans_default_domain 'sfs_media_admin' %}
{% extends '@SfsMedia/admin_layout.html.twig' %}
{% block title %}{{ 'admin_medias.list.meta.title'|trans }}{% endblock %}

{% form_theme filterForm '@SfsMedia/forms/admin_theme.html.twig' %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="content">{{ 'admin_medias.list.breadcrumb'|trans }}</li>
{% endblock breadcrums_content %}

{% block content %}
    {% if media_types is empty %}
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h1 class="h3">{{ 'admin_medias.list.title'|trans }}</h1>
        </div>
        <div class="container-fluid bg-white p-4">
            <div class="p-5 m-5">
                <p class="text-center text-muted">
                    {{ 'admin_medias.list.empty.no_types_configured.message_raw'|trans|raw }}
                    <br/>
                    <br/>
                    {{ 'admin_medias.list.empty.no_types_configured.go_to_doc_raw'|trans|raw }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h1 class="h3">{{ 'admin_medias.list.title'|trans }}</h1>

            <div class="float-end">
                {% block admin_medias_list_actions %}
                {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_CREATE') and media_types|length %}
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownCreateMedia"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            {{ 'admin_medias.list.actions.create.link'|trans }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownCreateMedia">
                            {% for key,type in media_types %}
                                <li><a href="{{ url('sfs_media_admin_medias_create', {'type':key}) }}"
                                       class="dropdown-item">{{ type.name }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% endblock admin_medias_list_actions %}
            </div>
        </div>

        {% if entities is empty and not filterForm.vars.submitted %}
            <div class="container-fluid bg-white p-4">
                <div class="p-5 m-5">
                    <p class="text-center text-muted">
                        {{ 'admin_medias.list.empty.create_first_raw'|trans|raw }}
                    </p>
                </div>
            </div>
        {% else %}
            {% if duplicates.total %}
                <div class="alert alert-warning" role="alert">
                    {{ 'admin_medias.alerts.total_duplicates_raw'|trans({'%different%': duplicates.different, '%total%': duplicates.total, '%duplicates%': duplicates.total - duplicates.different})|raw }}
                </div>
                {#{{ dump(duplicates) }}#}
            {% endif %}

            {{ form_start(filterForm) }}
            <div class="container-fluid bg-white">
                <div class="row">
                    <div class="col-12 col-md-3 col-xl-2 border-end p-3">
                        {% include '@SfsMedia/admin/media/list-filter-column.html.twig' %}
                    </div>
                    <div class="col-12 col-md-9 col-xl-10 p-3">
                        <div class="h-100 overflow-auto">
                            <div class="container-fluid mb-3">
                                <div class="row">
                                    <div class="col-4 col-md-6">
                                        {{ entities.total }} medias
                                    </div>
                                    <div class="col-4 col-md-3">{{ form_widget(filterForm.order, {'attr': {'onchange': 'submit()', 'class': 'form-control-sm'}}) }}</div>
                                    <div class="col-4 col-md-3">{{ form_widget(filterForm.sort, {'attr': {'onchange': 'submit()', 'class': 'form-control-sm'}}) }}</div>
                                </div>
                            </div>

                            {% if entities|length %}
                                <div class="container-fluid">
                                    <div class="row">
                                        {% include '@SfsMedia/admin/media/list-page.html.twig' %}
                                        {# {% include '@SfsComponents/paginator/pager.html.twig' with {'collection': entities} %} #}
                                    </div>
                                </div>
                            {% else %}
                                <div class="p-5 m-5">
                                    <p class="text-center text-muted">
                                        {{ 'admin_medias.list.empty.clean_filters_raw'|trans|raw }}
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock content %}

{% block body_end %}
    <div class="offcanvas offcanvas-end w-75" data-bs-scroll="false" data-bs-backdrop="true" tabindex="-1"
         id="mediaPreview" aria-labelledby="mediaPreviewLabel">
        {#    <div class="offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="mediaPreview" aria-labelledby="mediaPreviewLabel"> #}
        <div class="offcanvas-header">
            <h5 class="offcanvas-title flex-grow-1 text-break me-3" style="min-width: 0;" id="mediaPreviewLabel">Offcanvas</h5>
            <div class="offcanvas-header-actions d-flex flex-shrink-0 align-items-center text-nowrap">
                <div class="offcanvas-header-buttons d-flex flex-shrink-0 align-items-center text-nowrap"></div>
                <button type="button" class="btn-close p-4" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
        </div>
        <div class="offcanvas-body"></div>
    </div>

    <script type="text/javascript">
        const mediaPreview = document.getElementById('mediaPreview')
        mediaPreview.addEventListener('show.bs.offcanvas', event => {
            const detailsUrl = event.relatedTarget.dataset.offcanvasHref;
            const offcanvas = event.target;

            offcanvas.querySelector('#mediaPreviewLabel').innerHTML = event.relatedTarget.dataset.title +
                '<small class="small fw-normal fst-italic fs-6 d-block lh-sm mt-1">' + event.relatedTarget.dataset.description + '</small>';

            fetch(detailsUrl)
                .then(response => response.text())
                .then(html => {
                    offcanvas.querySelector('.offcanvas-body').innerHTML = html;

                    const headerBtns = offcanvas.querySelector('.offcanvas-body > .header-btns');
                    if (headerBtns) {
                        offcanvas.querySelector('.offcanvas-header .offcanvas-header-buttons').innerHTML = '';
                        offcanvas.querySelector('.offcanvas-header .offcanvas-header-buttons').appendChild(headerBtns);
                        headerBtns.classList.remove('d-none');
                    }
                });
        })


        /* Infinite scroll */

        let loadingNextPage = false;

        const loadNextMediaPage = function () {
            const scrollElement = document.querySelector('a[data-pagination="scroll"]');
            if (scrollElement && scrollElement.getBoundingClientRect().top <= window.innerHeight) {
                if (loadingNextPage) {
                    return;
                }

                loadingNextPage = true;
                // load ajax by XMLHttpRequest
                const xhr = new XMLHttpRequest();
                xhr.open('GET', scrollElement.href, true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4 && xhr.status === 200) {
                        console.log('loading next page');
                        scrollElement.outerHTML = xhr.responseText;
                    }

                    if (xhr.readyState === 4) {
                        loadingNextPage = false;
                    }
                };
                xhr.send();
            }
        };

        document.addEventListener('scroll', loadNextMediaPage, true);
        window.addEventListener('resize', loadNextMediaPage);
        loadNextMediaPage();

        document.addEventListener('click', function (e) {
            if (!e.target.matches('[data-bulk-select]')) {
                return;
            }

            e.stopPropagation();

            if (e.target.checked) {
                e.target.parentNode.parentNode.classList.add('border-danger');
            } else {
                e.target.parentNode.parentNode.classList.remove('border-danger');
            }
        });
    </script>
{% endblock body_end %}
