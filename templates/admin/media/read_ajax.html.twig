{% trans_default_domain 'sfs_media_admin' %}

{% import '@SfsMedia/admin/media/_macros.html.twig' as macros %}

{% include '@SfsMedia/admin/media/read_version_alerts.html.twig' %}

<div class="header-btns d-none">
    {% if (checkVersions.new|length) + (checkVersions.delete|length) + (checkVersions.changed|length) %}
        {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_MIGRATE', media) %}
            <a href="{{ url('sfs_media_admin_medias_migrate', {'media': media}) }}" class="btn btn-primary">{{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
        {% else %}
            <a class="btn btn-primary disabled">{{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
        {% endif %}
    {% endif %}
    {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_UPDATE', media) %}
        <a href="{{ url('sfs_media_admin_medias_update', {'media': media}) }}" class="btn btn-primary" title="{{ 'admin_medias.read.actions.update.button'|trans }}"><i class="bi bi-pencil-square"></i></a>
    {% else %}
        <a class="btn btn-primary disabled" title="{{ 'admin_medias.read.actions.update.button'|trans }}"><i class="bi bi-pencil-square"></i></a>
    {% endif %}
    {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_DELETE', media) %}
        <a href="{{ url('sfs_media_admin_medias_delete', {'media': media}) }}" class="btn btn-danger" title="{{ 'admin_medias.read.actions.delete.button'|trans }}"><i class="bi bi-trash"></i></a>
    {% else %}
        <a class="btn btn-danger disabled" title="{{ 'admin_medias.read.actions.delete.button'|trans }}"><i class="bi bi-trash"></i></a>
    {% endif %}
</div>

<ul class="nav nav-pills mb-3" id="tab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="original-tab" data-bs-toggle="pill" data-bs-target="#original" type="button" role="tab" aria-controls="original" aria-selected="true"><i class="bi bi-image"></i> Original</button>
    </li>
    {% for version in media.versions|filter((version) => version.version not in ['_original'])|sort((a, b) => (a.width+a.height) <=> (b.width+b.height))|reverse %}
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="{{ version.version }}-tab" data-bs-toggle="pill" data-bs-target="#{{ version.version }}" type="button" role="tab" aria-controls="{{ version.version }}" aria-selected="false"><i class="bi bi-image"></i> {{ version.version }}</button>
    </li>
    {% endfor %}
    {% if type_config.pictures|length %}
        {% for picture_id, config in type_config.pictures %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="{{ picture_id }}-tab" data-bs-toggle="pill" data-bs-target="#{{ picture_id }}"
                        type="button" role="tab" aria-controls="{{ picture_id }}" aria-selected="false"><i class="bi bi-code-slash"></i> {{ picture_id }}</button>
            </li>
        {% endfor %}
    {% endif %}
    {% if type_config.video_sets|length %}
        {% for video_set_id, config in type_config.video_sets %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="{{ video_set_id }}-tab" data-bs-toggle="pill" data-bs-target="#{{ video_set_id }}"
                        type="button" role="tab" aria-controls="{{ video_set_id }}" aria-selected="false"><i class="bi bi-play-btn"></i> {{ video_set_id }}</button>
            </li>
        {% endfor %}
    {% endif %}
    {% if linked_cms_versions is defined and linked_cms_versions|length %}
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="linked-cms-tab" data-bs-toggle="pill" data-bs-target="#linked-cms"
                    type="button" role="tab" aria-controls="linked-cms" aria-selected="false"><i class="bi bi-link"></i> linked CMS contents</button>
        </li>
    {% endif %}
</ul>
<div class="tab-content" id="tabContent">
    <div class="tab-pane fade show active" id="original" role="tabpanel" aria-labelledby="original-tab" tabindex="0">
        {{ macros.renderOriginal(media) }}
    </div>
    {% for version in media.versions|filter((version) => version.version not in ['_original'])|sort((a, b) => (a.width+a.height) <=> (b.width+b.height))|reverse %}
        <div class="tab-pane fade" id="{{ version.version }}" role="tabpanel" aria-labelledby="{{ version.version }}-tab" tabindex="0">
            {{ macros.renderVersion(media, version) }}
        </div>
    {% endfor %}

    {% if type_config.pictures|length %}
        {% for picture_id, config in type_config.pictures %}
            <div class="tab-pane fade" id="{{ picture_id }}" role="tabpanel" aria-labelledby="{{ picture_id }}-tab" tabindex="0">
                <h3>Picture tag: {{ picture_id }}</h3>
                <pre><code>&#123;&#123; media|sfs_media_render_picture('{{ picture_id }}', {'data-example':'test'}, {'class': 'img-fluid'}) &#125;&#125;

{{ media|sfs_media_render_picture(picture_id, {'data-example':'test'}, {'class': 'img-fluid'})|replace({'>':">\n"})|e('html') }}</code></pre>
            </div>
        {% endfor %}
    {% endif %}
    {% if type_config.video_sets|length %}
        {% for video_set_id, config in type_config.video_sets %}
            <div class="tab-pane fade" id="{{ video_set_id }}" role="tabpanel" aria-labelledby="{{ video_set_id }}-tab" tabindex="0">
                <h3>Video sources set: {{ video_set_id }}</h3>
                <pre><code>&#123;&#123; media|sfs_media_render_video_set('{{ video_set_id }}') &#125;&#125;

{{ media|sfs_media_render_video_set(video_set_id)|replace({'>':">\n"})|e('html') }}</code></pre>
            </div>
        {% endfor %}
    {% endif %}

    {% if linked_cms_versions is defined and linked_cms_versions|length %}
        <div class="tab-pane fade container" id="linked-cms" role="tabpanel" aria-labelledby="linked-cms-tab" tabindex="0">
{#            <h3>Linked CMS contents</h3>#}
            <ul>
                {% for content_version in linked_cms_versions %}
                    <li>
                        {% set content_type = sfs_cms_content_type(content_version.content) %}
                        <a href="{{ url('sfs_cms_admin_content_'~content_type~'_version_info', {'content':content_version.content, 'version':content_version}) }}">
                            {{ content_version.content.name }}
                            v{{ content_version.versionNumber }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</div>

