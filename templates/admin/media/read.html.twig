{% trans_default_domain 'sfs_media_admin' %}
{% extends '@SfsMedia/admin_layout.html.twig' %}
{% block title %}{{ 'admin_medias.read.meta.title'|trans({'%name%': media.name }) }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item"><a
                href="{{ url('sfs_media_admin_medias_list') }}">{{ 'admin_medias.list.breadcrumb'|trans }}</a></li>
    <li class="breadcrumb-item active"
        aria-current="content">{{ 'admin_medias.read.breadcrumb'|trans({'%name%': media.name }) }}</li>
{% endblock breadcrums_content %}

{% import '@SfsMedia/admin/media/_macros.html.twig' as macros %}

{% block content %}
    <div class="float-end">
        {% if (checkVersions.new|length) + (checkVersions.delete|length) + (checkVersions.changed|length) %}
            {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_MIGRATE', media) %}
                <a href="{{ url('sfs_media_admin_medias_migrate', {'media': media}) }}"
                   class="btn btn-primary">{{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
            {% else %}
                <a class="btn btn-primary disabled">{{ 'admin_medias.read.actions.migrate.button'|trans }}</a>
            {% endif %}
        {% endif %}
        {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_UPDATE', media) %}
            <a href="{{ url('sfs_media_admin_medias_update', {'media': media}) }}"
               class="btn btn-primary">{{ 'admin_medias.read.actions.update.button'|trans }}</a>
        {% else %}
            <a class="btn btn-primary disabled">{{ 'admin_medias.read.actions.update.button'|trans }}</a>
        {% endif %}
        {% if is_granted('PERMISSION_SFS_MEDIA_ADMIN_MEDIAS_DELETE', media) %}
            <a href="{{ url('sfs_media_admin_medias_delete', {'media': media}) }}"
               class="btn btn-danger">{{ 'admin_medias.read.actions.delete.button'|trans }}</a>
        {% else %}
            <a class="btn btn-danger disabled">{{ 'admin_medias.read.actions.delete.button'|trans }}</a>
        {% endif %}
    </div>

    <h1 class="h3 mb-4">{{ 'admin_medias.read.title'|trans({'%name%': media.name }) }}</h1>

    {% if media.description %}
        <p>{{ media.description|nl2br }}</p>
    {% endif %}

    {% include '@SfsMedia/admin/media/read_version_alerts.html.twig' %}

    {% include '@SfsMedia/admin/media/read_tabs.html.twig' %}

    <div class="container-fluid bg-white p-4">
        {% include '@SfsMedia/admin/media/read_tabs_content.html.twig' %}
    </div>
{% endblock content %}
