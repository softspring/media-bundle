{% trans_default_domain 'sfs_media_admin' %}

{% for version in checkVersions.new %}
    <div class="alert alert-danger" role="alert">
        {{ 'admin_medias.alerts.media_new_versions_raw'|trans({'%version%': version})|raw }}
    </div>
{% endfor %}
{% for version in checkVersions.delete %}
    <div class="alert alert-warning" role="alert">
        {{ 'admin_medias.alerts.media_delete_versions_raw'|trans({'%version%': version})|raw }}
    </div>
{% endfor %}
{% for version,changedOptions in checkVersions.changed %}
    <div class="alert alert-warning" role="alert">
        {{ 'admin_medias.alerts.media_changed_versions_raw'|trans({'%version%': version, '%change_list%': changedOptions|map((changedOption) => changedOption.string)|join(', ')})|raw }}
    </div>
{% endfor %}
{% for version in checkVersions.manual %}
    <div class="alert alert-warning" role="alert">
        {{ 'admin_medias.alerts.media_manual_versions_raw'|trans({'%version%': version})|raw }}
    </div>
{% endfor %}
{% if duplicates|length %}
    <div class="alert alert-warning" role="alert">
        {{ 'admin_medias.alerts.media_duplicates_raw'|trans({'%duplicates%': duplicates|length, '%url%': url('sfs_media_admin_medias_list', {'duplicates':media.id})})|raw }}
    </div>
{% endif %}