{% form_theme filterForm '@SfsMedia/forms/admin_theme.html.twig' %}

{% block fields %}
    {{ form_widget(filterForm.duplicates) }}

    {% if filterForm.duplicates.vars.media %}
        {# TODO update this layout for bootstrap #}
        <div class="ui info message visible" title="Duplicates this media">
            <i class="close icon" title="Clear this filter" onclick="document.getElementById('duplicates').value=''; this.closest('form').submit()"></i>

            {% if filterForm.duplicates.vars.media.isVideo %}
                {{ filterForm.duplicates.vars.media|sfs_media_render_video('_original', {'class':'img-fluid', 'style':' max-height: 50px; max-width: 100%;'}) }}
            {% elseif filterForm.duplicates.vars.media.isImage %}
                {{ filterForm.duplicates.vars.media|sfs_media_render_image(['_thumbnail'], {'class':'img-fluid', 'style':' max-height: 50px; max-width: 100%; width: auto;'}) }}
            {% endif %}
            {#            Duplicates this media#}
        </div>
    {% endif %}

    {% if filterForm.name is defined %}
        {{ form_row(filterForm.name, {'attr': {'onchange': 'submit()'}}) }}
    {% endif %}

    {% if filterForm.description is defined %}
        {{ form_row(filterForm.description, {'attr': {'onchange': 'submit()'}}) }}
    {% endif %}

    {% if filterForm.text is defined %}
        {{ form_row(filterForm.text, {'attr': {'onchange': 'submit()'}}) }}
    {% endif %}

    {% if filterForm.type is defined %}
        {{ form_row(filterForm.type, {}) }}
    {% endif %}

    {% if filterForm.content_entity is defined %}
        <div class="{{ filterForm.no_content_entity.vars.data|default(false) ? 'd-none' : '' }}">
            {{ form_row(filterForm.content_entity, {'attr': {'onchange': 'submit()'}}) }}
        </div>
    {% endif %}

    {% if filterForm.no_content_entity is defined %}
        <div class="{{ filterForm.content_entity.vars.data|default(false) ? 'd-none' : '' }}">
            {{ form_row(filterForm.no_content_entity, {'attr': {'onchange': 'submit()'}}) }}
        </div>
    {% endif %}
{% endblock %}

{% block actions %}
    <button type="submit" class="btn btn-primary btn-block w-100"><i class="bi bi-search"></i> Filter</button>

    {% if filterForm.vars.data|filter(v=>v) is not empty %}
        <a class="btn btn-link btn-block btn-sm mt-2 w-100" href="{{ url('sfs_media_admin_medias_list') }}"><i
                    class="bi bi-x-circle"></i> Clear filters</a>
    {% endif %}

{% endblock %}
